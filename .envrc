# direnv: activate the uv-managed Python 3.14 environment and load local config.
#
#   make setup     # creates .venv (uv, Python 3.14), installs deps + hooks
#   direnv allow   # trust this file once
#
# .venv and config.env are both gitignored; this file is not.

if [ -d .venv ]; then
    export VIRTUAL_ENV="$PWD/.venv"
    PATH_add "$VIRTUAL_ENV/bin"
fi

# Local camera credentials + viewer settings (optional; see config.env.example).
if [ -f config.env ]; then
    set -a
    source config.env
    set +a
fi

# When camera.json exists it is the camera's source of truth locally, because it
# is the shape the container mounts - so ordinary dev runs exercise that path.
# config.env still supplies the viewer settings (bind, port, auth, TZ); only its
# HIK_* camera values step aside, so there is exactly one place the camera comes
# from and no precedence notes on every start. Delete camera.json to go back to
# the HIK_* variables.
#
# Anchored to this file's own location, not $PWD: direnv can re-evaluate while the
# shell sits in a subdirectory, and pointing VIEWER_CONFIG at a missing path is a
# startup failure by design. BASH_SOURCE is the path of the file bash is sourcing.
_envrc_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$PWD/.envrc}")" && pwd)"
if [ -f "$_envrc_dir/camera.json" ]; then
    export VIEWER_CONFIG="$_envrc_dir/camera.json"
    unset HIK_HOST HIK_USER HIK_PASSWORD HIK_HTTP_PORT HIK_RTSP_PORT
fi
