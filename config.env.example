# Camera connection for hikvision-web-viewer.
# Copy to config.env and edit. config.env is gitignored (never commit credentials).
HIK_HOST=192.168.0.156
HIK_USER=admin
HIK_PASSWORD=change-me
HIK_RTSP_PORT=554
HIK_HTTP_PORT=80
# Set HIK_MOCK=1 to run against built-in fixtures (no camera needed; useful for UI work)
#HIK_MOCK=1
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8756
