# Camera connection for hikvision-web-viewer.
# Copy to config.env and edit. config.env is gitignored (never commit credentials).
HIK_HOST=192.168.0.156
HIK_USER=admin
HIK_PASSWORD=change-me
HIK_RTSP_PORT=554
HIK_HTTP_PORT=80
# Set HIK_MOCK=1 to run against built-in fixtures (no camera needed; useful for UI work)
#HIK_MOCK=1
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8756
# Optional: protect the viewer itself with HTTP Basic Auth.
# When both are set, every request requires credentials
# (browsers accept http://<user>:<pass>@<host>:8756/)
#VIEWER_AUTH_USER=viewer
#VIEWER_AUTH_PASSWORD=change-me
# On a weak NAS CPU, default the live view to the 360p sub channel:
#VIEWER_DEFAULT_CHANNEL=102
