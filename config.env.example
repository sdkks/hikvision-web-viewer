# Camera connection for hikvision-web-viewer.
# Copy to config.env and edit. config.env is gitignored (never commit credentials).
HIK_HOST=192.168.0.156
HIK_USER=admin
HIK_PASSWORD=change-me
HIK_RTSP_PORT=554
HIK_HTTP_PORT=80
# Optional: describe the camera in a JSON file instead of the HIK_* variables
# above. Point VIEWER_CONFIG at it; mount it read-only in a container (see
# compose.yaml). The file wins for the fields it sets; HIK_* fills the rest.
# The file is a single camera object, and the password in it is plaintext:
#   {"camera": {"host": "192.168.0.156", "http_port": 80, "rtsp_port": 554,
#               "user": "admin", "password": "change-me",
#               "tls": false, "tls_verify": false}}
#VIEWER_CONFIG=/config/camera.json
# Set HIK_MOCK=1 to run against built-in fixtures (no camera needed; useful for UI work)
#HIK_MOCK=1
# Display timezone for the UI (and day boundaries in the picker).
# In containers set it in compose.yaml; locally your system TZ is used.
#TZ=Asia/Singapore
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8756
# Optional: protect the viewer itself with HTTP Basic Auth.
# When both are set, every request requires credentials
# (browsers accept http://<user>:<pass>@<host>:8756/)
#VIEWER_AUTH_USER=viewer
#VIEWER_AUTH_PASSWORD=change-me
# Host names the viewer accepts in the Host header (comma-separated; ports are ignored).
# localhost, 127.0.0.1, ::1 and a specific VIEWER_BIND address are always accepted; set this
# when you reach the viewer by a LAN name or through a reverse proxy. This is the guard that
# stops a DNS-rebinding page from writing motion zones to the camera.
#VIEWER_ALLOWED_HOSTS=viewer.local,cam.lan
# On a weak NAS CPU, default the live view to the 360p sub channel:
#VIEWER_DEFAULT_CHANNEL=102
